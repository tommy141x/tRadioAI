{
  "name": "tradioai",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "tRadioAI: an AI dispatcher add-on for tRadio on FiveM",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "prod": "bun run scripts/prod.ts",
    "test": "bun test",
    "test:lua": "bun run scripts/test-lua.ts",
    "test:lua:control": "LUA_CONTROL=1 bun run scripts/test-lua.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "pins:check": "bun run scripts/pins-check.ts",
    "pins:check:control": "bun scripts/controls/pins-check-control.ts",
    "vendor:engine": "bun run scripts/vendor-local-engine.ts",
    "verify": "bun run lint && bun run typecheck && bun run test && bun run test:lua && bun run test:lua:control && bun run pins:check:control && bun run release:gate:control",
    "release:gate:control": "bun scripts/controls/release-gate-control.ts"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "consola": "^3.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/adm-zip": "^0.6.0",
    "@types/node": "^22.0.0",
    "bun-types": "^1.4.4",
    "fengari": "^0.1.5",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.11.0"
  }
}
