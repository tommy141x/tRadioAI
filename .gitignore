node_modules/
server/dist/
dist-release/

# Downloaded at first start, never committed. Weights are gigabytes; engines are
# upstream binaries this repo does not redistribute.
server/.cache/
server/bin/
server/models/*.gguf
server/models/*.bin
server/models/voices/*.onnx
server/models/validation.json
logs/

# Runtime state
*.log

# The developer's real credentials. Never committed, never packaged.
# The tracked config.lua holds blanks permanently; tlib.secrets overlays this
# file onto Config at server start. See tLib/shared/imports/secrets/server.lua.
config.local.lua
config/config.local.lua
