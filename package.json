{
  "name": "tradioai",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "tRadioAI: an AI dispatcher add-on for tRadio on FiveM",
  "secretGate": {
    "ignore": {
      "scripts/tests/config.lua": "a Lua test suite, not a config: its `SECRET = 'sk-this-must-never-leave-the-file-...'` is a synthetic canary proving tlib.config never echoes a secret into logs or events. The config rule matches it only because the basename contains `config`. Ignored by exact path, not by allowing `SECRET` everywhere."
    }
  },
  "scripts": {
    "secrets:check": "bun run ../tLib/scripts/secret-gate.ts",
    "secrets:install-hooks": "bun run ../tLib/scripts/secret-gate.ts --install-hooks",
    "secrets:check-hooks": "bun run ../tLib/scripts/secret-gate.ts --check-hooks",
    "build": "bun run scripts/build.ts",
    "prod": "bun run scripts/prod.ts",
    "test": "bun test",
    "test:lua": "bun run scripts/test-lua.ts",
    "test:lua:control": "LUA_CONTROL=1 bun run scripts/test-lua.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "pins:check": "bun run scripts/pins-check.ts",
    "pins:check:control": "bun scripts/controls/pins-check-control.ts",
    "vendor:engine": "bun run scripts/vendor-local-engine.ts",
    "notices:gen": "bun run scripts/third-party-notices.ts",
    "notices:check": "bun run scripts/third-party-notices.ts --check",
    "notices:check:control": "bun scripts/controls/notices-control.ts",
    "verify": "bun run lint && bun run typecheck && bun run typecheck:scripts && bun run test && bun run test:lua && bun run test:lua:control && bun run pins:check:control && bun run release:gate:control && bun run notices:check && bun run notices:check:control",
    "release:gate:control": "bun scripts/controls/release-gate-control.ts",
    "typecheck:scripts": "tsc --noEmit -p scripts/tsconfig.json",
    "harness": "bun scripts/harness/dispatch-harness.ts",
    "load": "bun scripts/harness/dispatch-load.ts"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "consola": "^3.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/adm-zip": "^0.6.0",
    "@types/node": "^22.0.0",
    "bun-types": "^1.4.4",
    "fengari": "^0.1.5",
    "fengari-node-cli": "^0.1.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.11.0"
  }
}
